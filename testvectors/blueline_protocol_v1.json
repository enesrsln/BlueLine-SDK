      "hex": "0104010400030118E803FA000406A0252600640013081B00EFCDAB8967452301",
      "expect": {
        "protocolVersion": 1,
        "model": 4,
        "hasFactorySerial": true,
        "channelCount": 4,
        "firmwareVersion": "0.3.1",
        "adcBits": 24,
        "adcRateHz": 1000,
        "signalRateHz": 250,
        "decimation": 4,
        "gain": 6,
        "vrefMicrovolts": 2500000,
        "memsRateHz": 100,
        "maxSamplesPerPacket": 19,
        "signalHeaderBytes": 8,
        "featureBits": 27,
        "features": [
          "signal",
          "mems",
          "identify",
          "setGain"
        ],
        "chipIdHex": "0123456789ABCDEF",
        "microvoltsPerCount": 0.04967053731282552,
        "isSupported": true
      }
    },
    {
      "name": "protocol 2 decodes but is unsupported",
      "hex": "0204010400030118E803FA000406A0252600640013081B00EFCDAB8967452301",
      "expect": {
        "protocolVersion": 2,
        "isSupported": false
