      "hex": "0104010400030118E803FA000406A02526006400130A1B00EFCDAB8967452301",
      "expect": {
        "signalHeaderBytes": 10,
        "isSupported": false
      }
    },
    {
      "name": "no signal feature is unsupported",
      "hex": "0104010400030118E803FA000406A0252600640013080200EFCDAB8967452301",
      "expect": {
        "featureBits": 2,
        "isSupported": false
      }
    },
    {
      "name": "gain 0 is rejected",
      "hex": "0104010400030118E803FA000400A0252600640013081B00EFCDAB8967452301",
      "expect": null
    },
    {
      "name": "31 bytes is rejected",
      "hex": "0104010400030118E803FA000406A0252600640013081B00EFCDAB89674523",
      "expect": null
    }
  ],
